NODE_ENV=development
PORT=5000

# Mongo DB
MONGO_URI=mongodb://127.0.0.1:27017/learning_backend

# JWT Access token
JWT_SECRET=
JWT_EXPIRES_IN=15m

# JWT Refresh Token
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=15d

# client url
CLIENT_URL=http://localhost:5173

# Email Setup
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CompanyName Technologies <noreply@companyname.com>

# ==========================
# Rate Limiting
# ==========================
# api
RATE_LIMIT_WINDOW=15m            # 15 minutes max 
RATE_LIMIT_MAX_REQUESTS=20       # 20 requests max in 15 minutes
# auth
AUTH_RATE_LIMIT_WINDOW=15m       # 15 minutes max 
AUTH_RATE_LIMIT_MAX_REQUESTS=5   # 5 requests max in 15 minutes

# ===========================================
# File Storage
# ===========================================
UPLOAD_DESTINATION=uploads #destination folder to save the images, it is common for all storage providers

FILE_STORAGE=local
UPLOAD_BASE_URL=http://localhost:3000

# Cloudinary
# FILE_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AWS
# FILE_STORAGE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# Azure
# FILE_STORAGE=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# Google cloud
# FILE_STORAGE=gcs
# GCS_PROJECT_ID=
# GCS_BUCKET=
# GCS_KEY_FILENAME=